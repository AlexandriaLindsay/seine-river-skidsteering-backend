# SMTP credentials for the cal@srskidsteering.ca mailbox.
# Once created in SiteGround (Site Tools > Email > Accounts), find these
# under Site Tools > Email > Email Programs ("Manually Configure") for that account.
SMTP_HOST=mail.srskidsteering.ca
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=cal@srskidsteering.ca
SMTP_PASS=

# Where submissions get sent — defaults to cal@srskidsteering.ca if unset.
TO_EMAIL=cal@srskidsteering.ca

# "From" header on outgoing mail. Defaults to the SMTP_USER if unset.
SMTP_FROM="SRS Website <cal@srskidsteering.ca>"

# The deployed frontend's origin, e.g. https://srskidsteering.ca
# Use * only for local development.
CORS_ORIGIN=*

PORT=3001
